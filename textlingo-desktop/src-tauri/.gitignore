# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# PDF offline assets are generated in CI (script/build_pdf_offline_assets.py),
# not committed (~95 MB). Keep the folder + README, ignore the binaries.
/resources/pdf-assets/models/
/resources/pdf-assets/fonts/

# Agent worker artifacts and runtimes are staged during CI/release builds.
/resources/agent-worker/*
!/resources/agent-worker/.gitkeep
/binaries/openkoto-agent-node-*
/binaries/opencode-*
